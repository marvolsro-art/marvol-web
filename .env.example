# ==============================================================================
# MARVOL S.R.O. - KONFIGURÁCIA ODOSIELANIA E-MAILOV PRE DOPYTY Z WEBU
# ==============================================================================
# Skopírujte tento súbor ako .env.local a doplňte jeden z dvoch spôsobov odosielania.
# Na produkcii (Vercel) pridajte tieto premenné do Project Settings -> Environment Variables.

# 1. Cieľová e-mailová adresa (kam majú chodiť dopyty obchodníkom)
NOTIFICATION_EMAIL=info@marvol.sk

# ------------------------------------------------------------------------------
# MOŽNOSŤ A: RESEND (NAJRÝCHLEJŠIE, NAJSPOĽAHLIVEJŠIE, 3 000 MAILOV/MESIAC ZADARMO)
# Registrácia: https://resend.com (1 minúta)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_vas_api_kluc_tu
# Predvolený odosielateľ (funguje okamžite aj bez overenia domény cez testovaciu Resend doménu):
RESEND_FROM=Marvol Dopyty <onboarding@resend.dev>
# Po overení domény marvol.sk v Resend môžete použiť napr:
# RESEND_FROM=Marvol s.r.o. <dopyty@marvol.sk>

# ------------------------------------------------------------------------------
# MOŽNOSŤ B: VLASTNÝ SMTP SERVER (WEBSUPPORT / GMAIL / FORPSI / VLASTNÁ SCHRÁNKA)
# Ak chcete maily posielať priamo cez existujúcu firemnú schránku:
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.websupport.sk
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@marvol.sk
# SMTP_PASS=vase_heslo_k_schranke
# SMTP_FROM=Marvol s.r.o. <info@marvol.sk>

# ------------------------------------------------------------------------------
# VOLITEĽNÉ: WEBHOOK (DISCORD / SLACK / MAKE / ZAPIER / CRM)
# ------------------------------------------------------------------------------
# LEAD_WEBHOOK_URL=https://discord.com/api/webhooks/...
